# campaign-service ortam değişkenleri
#
# Bu dosya servisin kodda gerçekten okuduğu değişkenleri listeler. Yanlarındaki değerler
# varsayılanlardır, yani hiçbiri verilmezse servis bu değerlerle çalışır.
#
# docker compose ile çalıştırırken bu dosyaya gerek yok, değişkenleri compose veriyor.
# Servisi tek başına IDE'den veya mvn spring-boot:run ile çalıştıracaksan buradaki
# varsayılanlar localhost'a göre ayarlı.
#
# Servisin dinlediği port kodda sabit 8080. Dışarıya hangi porttan çıktığını compose
# belirliyor (8082:8080), o yüzden burada bir port değişkeni yok.

# Veritabanı. Compose içinde host campaign-db, dışarıdan çalıştırırken localhost:5433.
DB_URL=jdbc:postgresql://localhost:5433/campaign
DB_USERNAME=postgres
DB_PASSWORD=postgres

# RabbitMQ. Kampanya olayları buradan yayınlanıyor, bkz. EVENTS.md.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# AI Service. Ulaşılamaz olması desteklenen bir durum, hata değil: kampanya yine oluşur,
# segment BELIRSIZ ve öncelik ORTA olarak işaretlenip manuel kuyruğa düşer.
AI_SERVICE_URL=http://localhost:8083

# Otomatik uzman ataması. false yapılırsa her yeni vaka süpervizörün elle atamasını bekler.
AI_AUTO_ASSIGN=true

# AI uzmanları EXP-001 gibi kendi kodlarıyla adlandırıyor, Identity ise UUID veriyor.
# Eşleme buraya yazılırsa otomatik atama gerçek personel hesaplarına düşer. Boş bırakılırsa
# AI'ın önerisi loglanıp yok sayılır ve vaka süpervizörü bekler, çünkü var olmayan bir
# hesaba atanmış vaka atanmamış vakadan daha kötüdür.
# Biçim: EXP-001=<uuid>,EXP-002=<uuid>
AI_EXPERT_MAPPING=

# SLA süre birimi. Case 5.4 üretimde saat diyor, demoda dakika yapılırsa 2 saatlik KRITIK
# SLA'nın aşımı canlı gösterilebilir hale gelir.
SLA_TIME_UNIT=hours

# SLA aşım taramasının sıklığı, milisaniye. SLA_TIME_UNIT=minutes yapıyorsan bunu da
# kısalt, yoksa aşımı 30 saniyeye kadar fark etmez.
SLA_SCAN_INTERVAL_MS=30000

# Geçerliliği dolmuş kampanyaların arşivlenme taraması, milisaniye.
CAMPAIGN_ARCHIVE_INTERVAL_MS=60000

# Abone projeksiyonunun CSV'den doldurulması. Tablo doluysa zaten hiçbir şey yapmaz.
SEED_ENABLED=true
