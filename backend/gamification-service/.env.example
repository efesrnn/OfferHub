# gamification-service ortam değişkenleri
#
# Bu dosya servisin kodda gerçekten okuduğu değişkenleri listeler. Yanlarındaki değerler
# varsayılanlardır, yani hiçbiri verilmezse servis bu değerlerle çalışır.
#
# docker compose ile çalıştırırken bu dosyaya gerek yok, değişkenleri compose veriyor.
# Servisi tek başına çalıştıracaksan buradaki varsayılanlar localhost'a göre ayarlı.
#
# Servisin dinlediği port kodda sabit 8080. Dışarıya hangi porttan çıktığını compose
# belirliyor (8084:8080), o yüzden burada bir port değişkeni yok.

# Veritabanı. Puan defteri ve kazanılmış rozetler burada, doğruluk kaynağı bu.
# Compose içinde host gamification-db, dışarıdan çalıştırırken localhost:5435.
DB_URL=jdbc:postgresql://localhost:5435/gamification
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis. Yalnızca liderlik sıralaması burada tutuluyor ve bu sıralama point_entries
# tablosundan türetilmiş bir veridir. Redis silinirse veri kaybolmaz,
# POST /api/v1/game/leaderboard/rebuild ile defterden yeniden kurulur.
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ. Servisi çalıştıran şey bu: puanlar campaign.optimized, sla.breached ve
# offer.rated olaylarından geliyor. Kuyruk yoksa yeni puan işlenmez, ama var olan profil
# ve liderlik sorguları çalışmaya devam eder.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
